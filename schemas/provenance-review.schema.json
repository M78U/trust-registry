{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "provenanceId",
    "certificateSHA256",
    "status",
    "recordedAt",
    "evidence",
    "reviewReferences"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "provenanceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "certificateSHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "PROVENANCE_VERIFIED",
        "REVIEW_REJECTED"
      ]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "reviewReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    }
  }
}
