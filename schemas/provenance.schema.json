{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unreviewed provenance record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "certificateSHA256",
    "sourceURL",
    "sourceType",
    "recordedAt",
    "sourceFileSHA256",
    "reviewStatus",
    "reviewEvidence",
    "redistributionStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "certificateSHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceURL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "sourceType": {
      "const": "UNVERIFIED_PUBLIC_SOURCE"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceFileSHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewStatus": {
      "const": "CANDIDATE"
    },
    "reviewEvidence": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string"
      }
    },
    "redistributionStatus": {
      "const": "NOT_REVIEWED"
    }
  }
}
