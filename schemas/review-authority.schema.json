{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseThreshold",
    "keys"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "releaseThreshold": {
      "type": "integer",
      "minimum": 2,
      "maximum": 32
    },
    "keys": {
      "type": "array",
      "minItems": 4,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "publicKey"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "role": {
            "enum": [
              "SOURCE_IDENTITY",
              "REVIEW",
              "RELEASE"
            ]
          },
          "publicKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$"
          }
        }
      }
    }
  }
}
