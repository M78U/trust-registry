{
  "name": "m78u-trust-registry",
  "compatibility_date": "2026-11-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "trust.m78u.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./release-dist",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": false
  }
}
